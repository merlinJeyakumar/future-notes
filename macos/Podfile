platform :osx, '10.15'
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', { 'Debug' => :debug, 'Profile' => :release, 'Release' => :release }

def flutter_root
  configuration = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  raise 'Run flutter pub get on this Mac before pod install' unless File.exist?(configuration)
  File.foreach(configuration) do |line|
    match = line.match(/FLUTTER_ROOT\=(.*)/)
    return match[1].strip if match
  end
  raise 'FLUTTER_ROOT missing; regenerate Flutter configuration on this Mac'
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)
flutter_macos_podfile_setup

office_root = File.join(__dir__, 'OfficeOxide')
unless File.directory?(File.join(office_root, 'OfficeOxide.xcframework')) &&
    %w[LICENSE-MIT LICENSE-APACHE NOTICE TRADEMARKS.md].all? { |name| File.file?(File.join(office_root, 'Licenses', name)) }
  raise 'Build the pinned macOS Office engine with tools/build-desktop-office.sh before pod install'
end

target 'Runner' do
  use_frameworks!
  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  pod 'FutureNotesOfficeOxide', :path => 'OfficeOxide'
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
  end
end
